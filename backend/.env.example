# InkIn 后端环境变量配置示例
# 复制此文件为 .env 并修改对应值

# Flask 服务配置
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# API 请求超时配置（秒）
API_TIMEOUT_SHORT=90
API_TIMEOUT_MEDIUM=120
API_TIMEOUT_LONG=180

# 场景分析配置
SCENE_ANALYSIS_TEMP=0.3
SCENE_ANALYSIS_TOKENS=1500

# 文件上传配置
UPLOAD_MAX_AGE_HOURS=24

# CORS 配置
# 开发环境使用 * 允许所有来源
# 生产环境应设置具体域名，多个域名用逗号分隔
# 示例：http://localhost:9527,https://inkin.example.com
CORS_ORIGINS=*

# 日志配置
# 可选值: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
